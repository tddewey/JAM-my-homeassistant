# NBA Jam Video Detection Configuration

video:
  # Path to video capture device (typically /dev/video0 or /dev/video1)
  device_path: /dev/video0
  # Interval between frame captures in seconds
  # (0.15 gives ~0.3 s score latency: a score needs 2 agreeing reads)
  frame_interval: 0.15
  # Capture resolution
  capture_width: 1920
  capture_height: 1080
  # Resolution the detection regions below were measured at. Regions are scaled
  # to the capture size, so changing capture_width/height does not break them.
  # Omit to treat the regions as already being in capture pixels.
  reference_width: 1920
  reference_height: 1080
  # Early grayscale conversion (reduces memory and processing)
  use_grayscale: true
  # Capture rate requested from the card (frames are still only processed every
  # frame_interval; a low rate just saves conversion work). Omit for the card default.
  fps: 30
  # Pixel format requested from the capture card. YUYV is uncompressed (no JPEG
  # artifacts, best for template matching); MJPG uses less USB bandwidth.
  fourcc: YUYV

detection:
  # Learned templates (see build_templates.py / build_scene_templates.py)
  templates_path: templates/nbajam.npz
  scenes_path: templates/scenes.npz

  # Regions measured on the RetroArch CRT-shader output at 1920x1080
  # (use show_regions.py to check them against a frame).
  score_regions:
    player1:
      x: 1300      # Wide enough for 3-digit scores (right-aligned digits)
      y: 770
      width: 170
      height: 90
    player2:
      x: 1300
      y: 860
      width: 170
      height: 95

  # Region where quarter/period text appears ("1ST QUARTER", "HALFTIME", "FINAL")
  quarter_text_region:
    x: 470
    y: 965
    width: 470
    height: 65

  # Plain stretch of the purple overlay band to the right of the clock. Its purple
  # fraction gates all OCR work. (The stretch between the quarter text and the
  # "TOURNAMENT EDITION" logo is NOT safe: "END OF 4TH QUARTER" runs over it.)
  purple_band_region:
    x: 1385
    y: 990
    width: 170
    height: 25

  # Team selection heading region has not been measured at 1080p yet.
  # team_selection_heading_region:
  #   x: 0
  #   y: 0
  #   width: 0
  #   height: 0

  # Motion detection threshold (0.0 to 1.0, lower = more sensitive)
  motion_threshold: 0.1

  # Minimum confidence for score detection (0.0 to 1.0)
  confidence_threshold: 0.7

mqtt:
  # Enable/disable MQTT publishing (set to true when ready)
  enabled: false
  
  # MQTT broker settings
  broker: localhost
  port: 1883
  username: null  # Set to null if no authentication
  password: null  # Set to null if no authentication
  
  # Topic prefix for all MQTT topics
  topic_prefix: nba_jam

tuning:
  # Enable CPU monitoring in console
  monitor_cpu: false
  # Interval between metrics display (seconds)
  metrics_interval: 10

screenshots:
  # Enable screenshot capture (can be overridden with --save-screenshots CLI flag)
  enabled: false
  # Directory to save screenshots (default: ~/nba-jam-screenshots)
  directory: ~/nba-jam-screenshots
  # Maximum number of screenshots to keep (0 = unlimited)
  max_count: 20
  # Maximum age in days before deletion (0 = no age limit)
  max_age_days: 7

